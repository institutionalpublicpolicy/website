{#-
  Base layout. Every page passes `lang` (en|fr|it), `file` (its filename,
  used for the language switcher and the current-page marker) and `title`.
-#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if file %}
{%- for L in langs %}
<link rel="alternate" hreflang="{{ L }}" href="{{ site.url }}/{{ L | langRoot }}{{ file }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/{{ file }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} blog" href="{{ site.url }}/blog/feed.xml">
{%- endif %}
{%- set ogimg = image or site.og_image -%}
{%- set locales = { "en": "en_US", "fr": "fr_FR", "it": "it_IT" } -%}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ 'book' if image else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ locales[lang] }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title }}">
{%- if description %}
<meta property="og:description" content="{{ description }}">
{%- endif %}
<meta property="og:image" content="{{ site.url }}{{ ogimg }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
{%- if description %}
<meta name="twitter:description" content="{{ description }}">
{%- endif %}
<meta name="twitter:image" content="{{ site.url }}{{ ogimg }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} podcast" href="{{ site.url }}/podcast/feed.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Institutional Public Policy Press",
  "alternateName": "IPP Press",
  "url": "{{ site.url }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "100 United Nations Plaza",
    "addressLocality": "New York",
    "addressRegion": "NY",
    "postalCode": "10017",
    "addressCountry": "US"
  }
}
</script>

<link rel="stylesheet" href="/style.css?v={{ buildStamp }}">
</head>
<body>
<div class="frame">

<header class="masthead">
  {%- if file == "index.html" %}
  <h1 class="wordmark"><span>Institutional </span><span>Public Policy Press</span></h1>
  {%- else %}
  <a class="wordmark" href="/{{ lang | langRoot }}"><span>Institutional </span><span>Public Policy Press</span></a>
  {%- endif %}
  <p class="place">{{ site.place }}</p>
  <nav aria-label="Main">
    <ul>
    {%- for item in site.nav[lang] %}
      {%- set href = ("/" + item.href) if item.root else ("/" + (lang | langRoot) + item.href) %}
      <li><a href="{{ href }}"{% if item.href == file or (item.root and section == item.href) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
    {%- endfor %}
    </ul>
  </nav>
  {%- if file %}
  <nav class="langs" aria-label="Language">
    <ul>
    {%- for L in langs %}
      <li><a href="/{{ L | langRoot }}{{ file }}" hreflang="{{ L }}"{% if L == lang %} aria-current="true"{% endif %}>{{ L | upper }}</a></li>
    {%- endfor %}
    </ul>
  </nav>
  {%- endif %}
</header>

<main class="{{ width or 'column' }}">
  <hr class="gold-rule">

{{ content | safe }}

</main>

<footer>
  <p>{{ site.name }}, {{ site.place }}</p>
  <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
</footer>

</div>
</body>
</html>
