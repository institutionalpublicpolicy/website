<p class="listen-on"><span class="listen-label">{{ site.labels.listen_on.en }}</span>
  {%- if links.podcast_apple %} <a class="listen-btn" href="{{ links.podcast_apple }}" rel="noopener">Apple Podcasts</a>{% endif %}
  {%- if links.podcast_spotify %} <a class="listen-btn" href="{{ links.podcast_spotify }}" rel="noopener">Spotify</a>{% endif %}
  <a class="listen-btn" href="/podcast/feed.xml">RSS</a>
  {%- if not links.podcast_apple and not links.podcast_spotify %} <span class="quiet listen-coming">{{ site.labels.podcast_coming.en }}</span>{% endif %}
</p>
