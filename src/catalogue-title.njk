---
pagination:
  data: collections.titleLangs
  size: 1
  alias: tl
  addAllPagesToCollections: true
permalink: "{{ tl.lang | langRoot }}catalogue/{{ tl.title.data.slug }}.html"
layout: base.njk
eleventyComputed:
  lang: "{{ tl.lang }}"
  file: "catalogue/{{ tl.title.data.slug }}.html"
  title: "{{ tl.title.data.title[tl.lang] | safe }} — Institutional Public Policy Press"
  description: "{{ tl.title.data.subtitle[tl.lang] | safe }}"
---
{%- set L = tl.lang -%}
{%- set d = tl.title.data -%}
<article class="book">

{%- if d.cover %}
<figure class="book-cover">
  <img src="/media/{{ d.cover }}" alt="{{ d.title | t(L) }}">
  {%- if d.status == "forthcoming" %}<figcaption>{{ site.labels.forthcoming | t(L) }}</figcaption>{% endif %}
</figure>
{%- endif %}

<h1>{{ d.title | t(L) }}</h1>
<p class="book-subtitle lead-sub">{{ d.subtitle | t(L) }}</p>
{%- if d.author %}<p class="book-author">{{ d.author }}</p>{% endif %}

<dl class="meta">
  {%- if d.author %}
  <div><dt>{{ site.labels.author | t(L) }}</dt><dd>{{ d.author }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.publisher | t(L) }}</dt><dd>{{ site.name }}, {{ site.place }}</dd></div>
  <div><dt>{{ site.labels.status | t(L) }}</dt><dd>{% if d.status == "forthcoming" %}{{ site.labels.in_preparation | t(L) }}{% else %}{{ site.labels.published | t(L) }}{% endif %}</dd></div>
  {%- if d.pubdate %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.pubdate }}</dd></div>
  {%- elif d.year %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.year }}</dd></div>
  {%- endif %}
  {%- if d.pages %}
  <div><dt>{{ site.labels.pages | t(L) }}</dt><dd>{{ d.pages }} {{ site.labels.pp | t(L) }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.editions | t(L) }}</dt><dd>
    {{- site.labels.lang_en | t(L) }}{% if d.isbn and d.isbn.en %} (ISBN {{ d.isbn.en }}){% endif %},
    {{ site.labels.lang_fr | t(L) }}{% if d.isbn and d.isbn.fr %} (ISBN {{ d.isbn.fr }}){% endif %},
    {{ site.labels.lang_it | t(L) }}{% if d.isbn and d.isbn.it %} (ISBN {{ d.isbn.it }}){% endif %}
  </dd></div>
  {%- if d.doi %}
  <div><dt>{{ site.labels.doi | t(L) }}</dt><dd><a href="https://doi.org/{{ d.doi }}">{{ d.doi }}</a></dd></div>
  {%- endif %}
  {%- if d.subjects and d.subjects[L] %}
  <div><dt>{{ site.labels.subjects | t(L) }}</dt><dd>{{ d.subjects[L] }}</dd></div>
  {%- endif %}
</dl>

{%- if d.description and d.description[L] %}
{{ d.description[L] | md | safe }}
{%- endif %}

{%- if d.preface and d.preface[L] %}
<h2>{{ d.preface_heading | t(L) or site.labels.preface | t(L) }}</h2>
{{ d.preface[L] | md | safe }}
{%- endif %}

{%- if d.review_record and d.review_record[L] %}
<h2>{{ site.labels.review | t(L) }}</h2>
{{ d.review_record[L] | md | safe }}
{%- endif %}

</article>
