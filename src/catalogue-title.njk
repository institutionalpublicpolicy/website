---
pagination:
  data: collections.titleLangs
  size: 1
  alias: tl
  addAllPagesToCollections: true
permalink: "{{ tl.lang | langRoot }}catalogue/{{ tl.title.data.slug }}.html"
layout: base.njk
width: wide
eleventyComputed:
  lang: "{{ tl.lang }}"
  file: "catalogue/{{ tl.title.data.slug }}.html"
  title: "{{ tl.title.data.title[tl.lang] | safe }} — Institutional Public Policy Press"
  description: "{{ tl.title.data.subtitle[tl.lang] | safe }}"
---
{%- set L = tl.lang -%}
{%- set d = tl.title.data -%}
<article class="book">

{%- set cov = d.cover[L] or d.cover.en or d.cover -%}
{%- if cov %}
<figure class="book-cover">
  <img src="{{ cov }}" alt="{{ d.title | t(L) }}">
  {%- if d.status == "forthcoming" %}<figcaption>{{ site.labels.forthcoming | t(L) }}</figcaption>{% endif %}
</figure>
{%- endif %}

<h1>{{ d.title | t(L) }}</h1>
<p class="book-subtitle lead-sub">{{ d.subtitle | t(L) }}</p>
{%- if d.author %}<p class="book-author">{{ d.author }}</p>{% endif %}

<dl class="meta">
  {%- if d.author %}
  <div><dt>{{ site.labels.author | t(L) }}</dt><dd>{{ d.author }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.publisher | t(L) }}</dt><dd>{{ site.name }}, {{ site.place }}</dd></div>
  <div><dt>{{ site.labels.status | t(L) }}</dt><dd>{% if d.status == "forthcoming" %}{{ site.labels.in_preparation | t(L) }}{% else %}{{ site.labels.published | t(L) }}{% endif %}</dd></div>
  {%- if d.pubdate %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.pubdate }}</dd></div>
  {%- elif d.year %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.year }}</dd></div>
  {%- endif %}
  {%- if d.pages %}
  <div><dt>{{ site.labels.pages | t(L) }}</dt><dd>{{ d.pages }} {{ site.labels.pp | t(L) }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.editions | t(L) }}</dt><dd>
    {{- site.labels.lang_en | t(L) }}{% if d.isbn and d.isbn.en %} (ISBN {{ d.isbn.en }}){% endif %},
    {{ site.labels.lang_fr | t(L) }}{% if d.isbn and d.isbn.fr %} (ISBN {{ d.isbn.fr }}){% endif %},
    {{ site.labels.lang_it | t(L) }}{% if d.isbn and d.isbn.it %} (ISBN {{ d.isbn.it }}){% endif %}
  </dd></div>
  {%- if d.doi %}
  <div><dt>{{ site.labels.doi | t(L) }}</dt><dd><a href="https://doi.org/{{ d.doi }}">{{ d.doi }}</a></dd></div>
  {%- endif %}
  {%- if d.subjects and d.subjects[L] %}
  <div><dt>{{ site.labels.subjects | t(L) }}</dt><dd>{{ d.subjects[L] }}</dd></div>
  {%- endif %}
</dl>
{%- if d.sample and d.sample[L] %}
<p class="sample"><a href="{{ d.sample[L] }}" download>{{ d.sample_label[L] or site.labels.sample | t(L) }} (PDF)</a></p>
{%- endif %}

{%- if d.description and d.description[L] %}
{{ d.description[L] | md | safe }}
{%- endif %}

{%- if d.contents and d.contents[L] %}
<h2>{{ site.labels.contents | t(L) }}</h2>
<div class="toc">
{{ d.contents[L] | md | safe }}
</div>
{%- endif %}

{%- if d.preface and d.preface[L] %}
<h2>{{ d.preface_heading | t(L) or site.labels.preface | t(L) }}</h2>
{{ d.preface[L] | md | safe }}
{%- endif %}

{%- if d.review_record and d.review_record[L] %}
<h2>{{ site.labels.review | t(L) }}</h2>
{{ d.review_record[L] | md | safe }}
{%- endif %}
{%- set fulltitle %}{{ d.title | t(L) }}{% if d.subtitle | t(L) %}: {{ d.subtitle | t(L) }}{% endif %}{% endset -%}
{%- set auth = (d.author.split(" ") | last) + ", " + (d.author.split(" ") | first) if d.author else site.name -%}
{%- set isbn = d.isbn[L] if d.isbn else "" -%}
<details class="cite">
<summary>{{ site.labels.cite | t(L) }}</summary>
<div class="cite-item"><span class="cite-style">APA</span><pre>{{ auth }} ({{ d.year }}). <em>{{ fulltitle }}</em>. {{ site.name }}.{% if d.doi %} https://doi.org/{{ d.doi }}{% endif %}</pre><button type="button" data-copy>{{ site.labels.copy | t(L) }}</button></div>
<div class="cite-item"><span class="cite-style">Chicago</span><pre>{{ auth }}. <em>{{ fulltitle }}</em>. {{ site.place }}: {{ site.name }}, {{ d.year }}.{% if d.doi %} https://doi.org/{{ d.doi }}.{% endif %}</pre><button type="button" data-copy>{{ site.labels.copy | t(L) }}</button></div>
<div class="cite-item"><span class="cite-style">BibTeX</span><pre>@book{{ "{" }}{{ d.slug }}{{ d.year }},
  author    = {{ "{" }}{{ auth }}},
  title     = {{ "{" }}{{ fulltitle }}},
  publisher = {{ "{" }}{{ site.name }}},
  address   = {{ "{" }}{{ site.place }}},
  year      = {{ "{" }}{{ d.year }}}{% if isbn %},
  isbn      = {{ "{" }}{{ isbn }}}{% endif %}{% if d.doi %},
  doi       = {{ "{" }}{{ d.doi }}}{% endif %}
}</pre><button type="button" data-copy>{{ site.labels.copy | t(L) }}</button></div>
</details>
<script>
document.querySelectorAll('.cite [data-copy]').forEach(function (b) {
  b.addEventListener('click', function () {
    navigator.clipboard.writeText(b.previousElementSibling.innerText).then(function () {
      b.textContent = '{{ site.labels.copied | t(L) }}';
      setTimeout(function () { b.textContent = '{{ site.labels.copy | t(L) }}'; }, 1500);
    });
  });
});
</script>

</article>
