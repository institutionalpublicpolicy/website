---
pagination:
  data: collections.titleLangs
  size: 1
  alias: tl
  addAllPagesToCollections: true
permalink: "{{ tl.lang | langRoot }}catalogue/{{ tl.title.data.slug }}.html"
layout: base.njk
width: wide
eleventyComputed:
  image: "/media/og-{{ tl.title.data.slug }}-{{ tl.lang }}.png"
  lang: "{{ tl.lang }}"
  file: "catalogue/{{ tl.title.data.slug }}.html"
  title: "{{ tl.title.data.title[tl.lang] | safe }} — Institutional Public Policy Press"
  description: "{{ (tl.title.data.description[tl.lang] | md | striptags | truncate(220)) if tl.title.data.description and tl.title.data.description[tl.lang] else tl.title.data.subtitle[tl.lang] | safe }}"
---
{%- set L = tl.lang -%}
{%- set d = tl.title.data -%}
<article class="book">

{%- set cov = d.cover[L] or d.cover.en or d.cover -%}
{%- if cov %}
<figure class="book-cover">
  <img src="{{ cov }}" alt="{{ d.title | t(L) }}">
  {%- if d.status == "forthcoming" %}<figcaption>{{ site.labels.forthcoming | t(L) }}</figcaption>{% endif %}
</figure>
{%- endif %}

<h1>{{ d.title | t(L) }}</h1>
<p class="book-subtitle lead-sub">{{ d.subtitle | t(L) }}</p>
{%- if d.author %}<p class="book-author">{{ d.author }}</p>{% endif %}

<dl class="meta">
  {%- if d.author %}
  <div><dt>{{ site.labels.author | t(L) }}</dt><dd>{{ d.author }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.publisher | t(L) }}</dt><dd>{{ site.name }}, {{ site.place }}</dd></div>
  <div><dt>{{ site.labels.status | t(L) }}</dt><dd>{% if d.status == "forthcoming" %}{{ site.labels.in_preparation | t(L) }}{% else %}{{ site.labels.published | t(L) }}{% endif %}</dd></div>
  {%- if d.pubdate %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.pubdate }}</dd></div>
  {%- elif d.year %}
  <div><dt>{{ site.labels.pubdate | t(L) }}</dt><dd>{{ d.year }}</dd></div>
  {%- endif %}
  {%- if d.pages %}
  <div><dt>{{ site.labels.pages | t(L) }}</dt><dd>{{ d.pages }} {{ site.labels.pp | t(L) }}</dd></div>
  {%- endif %}
  <div><dt>{{ site.labels.editions | t(L) }}</dt>
