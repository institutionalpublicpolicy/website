---
pagination:
  data: collections.pageLangs
  size: 1
  alias: pl
  addAllPagesToCollections: true
permalink: "{{ pl.lang | langRoot }}{{ pl.page.data.file }}"
layout: base.njk
eleventyComputed:
  lang: "{{ pl.lang }}"
  file: "{{ pl.page.data.file }}"
  title: "{{ pl.page.data.title[pl.lang] | safe }}{% if pl.page.data.key != 'about' %} — Institutional Public Policy Press{% endif %}"
  description: "{{ pl.page.data.description[pl.lang] | safe }}"
---
{%- set L = pl.lang -%}
{%- set d = pl.page.data -%}
{%- set txt = d.text or d.body -%}
{%- if d.key == "about" %}
{{ txt[L] | md | safe }}
<a class="ring" href="/{{ L | langRoot }}catalogue.html" aria-label="{{ site.labels.forthcoming | t(L) }}: Institutional Capital Theory">
  <svg viewBox="0 0 300 300" aria-hidden="true">
    <defs><path id="ring-path" d="M150,150 m-118,0 a118,118 0 1,1 236,0 a118,118 0 1,1 -236,0"/></defs>
    <text><textPath href="#ring-path">{{ site.labels.forthcoming | t(L) }} · Institutional Capital Theory · Institutional Public Policy Press · New York ·</textPath></text>
  </svg>
  <span class="centre"><span class="initials">IPP</span></span>
</a>

{%- set forthcoming = collections.titles | selectattr("data.status", "equalto", "forthcoming") | list %}
{%- if forthcoming | length %}
<h2>{{ site.labels.forthcoming | t(L) }}</h2>
{%- for t in forthcoming %}
<p><a href="/{{ L | langRoot }}catalogue/{{ t.data.slug }}.html"><cite>{{ t.data.title | t(L) }}</cite></a>. {{ t.data.subtitle | t(L) }}</p>
{%- endfor %}
{%- endif %}

{%- elif d.key == "contact" %}
<h1>{{ d.title[L] }}</h1>
{{ txt[L] | md | safe }}
<p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
<p class="quiet">{{ site.name }}<br>{{ site.address | t(L) | safe }}</p>

{%- else %}
<h1>{{ d.title[L] }}</h1>
{{ txt[L] | md | safe }}
{%- endif %}
