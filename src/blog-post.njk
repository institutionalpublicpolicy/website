---
pagination:
  data: collections.pageLangs
  size: 1
  alias: pl
  addAllPagesToCollections: true
permalink: "blog/{{ p.fileSlug }}.html"
layout: base.njk
lang: en
section: "blog/"
eleventyComputed:
  title: "{{ p.data.title | safe }} — Institutional Public Policy Press"
  description: "{{ p.data.summary | safe }}"
---
<p class="entry-date">{{ p.date | dateLong("en") }}</p>
<h1>{{ p.data.title }}</h1>
{{ p.templateContent | safe }}
<p class="quiet"><a href="/blog/">&larr; Blog</a></p>
